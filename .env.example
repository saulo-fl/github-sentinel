# GitHub fine-grained PAT read-only: Issues + Pull requests + Metadata.
# Genéralo en https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=

# LLM con API compatible OpenAI. En APOLO: Ollama local.
# Si no está disponible, el dashboard funciona igual: las issues aparecerán como "pendiente de análisis".
LLM_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3-vl:4b-instruct
# Ollama no valida auth; puede ser cualquier string.
LLM_API_KEY=sentinel-local
LLM_MAX_CONTEXT_TOKENS=4096

# Cada cuánto barrer los repos (milisegundos).
# 30 min = 1800000 · 10 min = 600000 · 5 min = 300000
SENTINEL_INTERVAL_MS=1800000

# Ruta al SQLite. Puede ser relativa al proyecto o absoluta.
SENTINEL_DB_PATH=data/sentinel.db

# Servidor HTTP.
PORT=3741
# Local: 127.0.0.1. En APOLO: la IP Tailscale (<IP-TAILSCALE>), visible solo en el tailnet.
HOST=127.0.0.1

# Notificaciones por Telegram.
# 1) Crea un bot con @BotFather y pega aquí su token.
# 2) Mándale /start al bot.
# 3) Tu chat id sale de getUpdates: result[].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# false pausa los envíos sin borrar las credenciales.
TELEGRAM_ENABLED=true
# Pausa entre mensajes si un digest manda varios.
TELEGRAM_SEND_INTERVAL_MS=1000
# Zona horaria para formatear la fecha del mensaje.
DIGEST_TIMEZONE=America/Mexico_City
# Bun.cron usa la zona horaria del sistema (APOLO: America/Mexico_City): 09:00 y 18:00 locales.
DIGEST_CRON="0 9,18 * * *"
